APP_NAME=super-merchant
APP_PORT=8110

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5471
DB_DATABASE=super_merchant
DB_USERNAME=tms
DB_PASSWORD=secret

# gRPC Configuration
GRPC_TIMEOUT=30
GRPC_BATCH_TIMEOUT=120
GRPC_LOGGING=true

# gRPC service endpoints (local dev ports — Quarkus shares HTTP+gRPC on same port)
USER_SERVICE_GRPC_HOST=localhost
USER_SERVICE_GRPC_PORT=8081
WALLET_SERVICE_GRPC_HOST=localhost
WALLET_SERVICE_GRPC_PORT=8083
CONFIG_SERVICE_GRPC_HOST=localhost
CONFIG_SERVICE_GRPC_PORT=8086
TRANSACTION_SERVICE_GRPC_HOST=localhost
TRANSACTION_SERVICE_GRPC_PORT=8084
NOTIFICATION_SERVICE_GRPC_HOST=localhost
NOTIFICATION_SERVICE_GRPC_PORT=8087
LEDGER_SERVICE_GRPC_HOST=localhost
LEDGER_SERVICE_GRPC_PORT=8088
SETTLEMENT_SERVICE_GRPC_HOST=localhost
SETTLEMENT_SERVICE_GRPC_PORT=8089
KYC_SERVICE_GRPC_HOST=localhost
KYC_SERVICE_GRPC_PORT=8085
DISPUTE_SERVICE_GRPC_HOST=localhost
DISPUTE_SERVICE_GRPC_PORT=8102

# JWT
JWT_SECRET=

# Source Database for Replication (tms-api database)
SOURCE_DB_HOST=tms-postgres
SOURCE_DB_PORT=5432
SOURCE_DB_DATABASE=tms
SOURCE_DB_USERNAME=tms
SOURCE_DB_PASSWORD=secret

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north-1
AWS_BUCKET=

# =============================================================================
# Microservice Database Connections (for logical replication subscriptions)
# =============================================================================

